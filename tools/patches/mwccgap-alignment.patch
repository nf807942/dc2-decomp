index 597dd53..b136742 100644
--- a/mwccgap/preprocessor.py
+++ b/mwccgap/preprocessor.py
@@ -31,12 +31,57 @@ C_MACRO_END = """
 #endif
 """.splitlines()
 
+# The address a data line carries: `/* <offset> <vram> [<bytes>] */ .word ...`.
+DATA_ADDRESS_REGEX = re.compile(r"^/\*\s+\S+\s+([0-9A-Fa-f]{8})\b")
+
+
+def alignment_of(address: int) -> int:
+    """The alignment an address satisfies, between 4 and 16.
+
+    mwcc asks 16 bytes for every section it emits, and the linker pads up to it.
+    A grafted symbol the binary places elsewhere would be pushed, along with
+    everything after it; taking the alignment from the address keeps it put.
+    """
+    align = 16
+    while align > 4 and address % align:
+        align //= 2
+    return align
+
+
+def text_address(asm_file: Path) -> int:
+    """The address the disassembly gives a function, from its first instruction.
+
+    The .text section is not necessarily the first one in the file: a function
+    that jumps through a table has that table migrated ahead of its body, and
+    the first address in the file would then be the table's. A file that names
+    no section at all is text throughout, which is the ordinary case.
+    """
+    in_text = True
+    with asm_file.open("r", encoding="utf-8") as handle:
+        for line in handle:
+            line = line.strip()
+            if line.startswith(".section"):
+                in_text = line.endswith(".text")
+            elif in_text and (match := DATA_ADDRESS_REGEX.match(line)):
+                return int(match.group(1), 16)
+    return 0
+
 
 @dataclass
 class Symbol:
     name: str
     size: int = 0
     local: bool = False
+    # The address the disassembly gives the symbol, from the comment its first
+    # data line carries. Two symbols in the same .rodata range may be separated
+    # by alignment padding, which the disassembly states as a directive rather
+    # than as bytes; without the address, that padding has nowhere to come from
+    # and every symbol after the first lands short.
+    address: int = 0
+
+    @property
+    def align(self) -> int:
+        return alignment_of(self.address)
 
 
