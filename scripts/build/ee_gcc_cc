#!/usr/bin/env python3
"""Le compilateur C de la voie GCC, sous l'interface que `mwccgap` attend de MWCC.

    ee_gcc_cc -c <options> -o sortie.o source.c

`mwccgap` appelle « le compilateur » ainsi ; ce script le fait tenir par `ee-gcc`. La
version se choisit par l'environnement (`EE_GCC`, `ee-gcc2.9-991111-01` par défaut) et les
options passent telles quelles (`-O2 -G0` en tête de ce que le Makefile donne).

**Pourquoi un script et non l'appel direct.** Les `ee-gcc` 2.9x sont des binaires i386
32 bits dont le `stat` échoue sur les numéros d'inode du montage Windows (« Value too large
for defined data type »). Le compilateur, ses en-têtes (`include/gcc/`) et la source sont
donc copiés dans `/tmp` avant de compiler. La copie du compilateur se garde d'un appel à
l'autre (`/tmp/ee-gcc-cache/<version>`), sans quoi chaque unité paierait 2 Mo de copie.
"""

import os
import re
import shutil
import subprocess
import sys
import tempfile
from pathlib import Path

ROOT = Path(__file__).resolve().parents[2]
CACHE = Path("/tmp/ee-gcc-cache")


def compilateur(nom: str) -> Path:
    cible = CACHE / nom
    if cible.exists():
        return cible
    CACHE.mkdir(parents=True, exist_ok=True)
    partiel = Path(tempfile.mkdtemp(dir=CACHE, prefix=nom + "."))
    shutil.copytree(ROOT / "tools" / "compilers" / nom, partiel / "c")
    try:
        (partiel / "c").rename(cible)      # atomique : deux unités peuvent arriver ensemble
    except OSError:
        pass                                # l'autre a gagné
    shutil.rmtree(partiel, ignore_errors=True)
    return cible


# Les dossiers de newlib qu'une unité peut inclure : les en-têtes publics, et ceux que
# chaque famille de sources garde à côté d'elle (`local.h` de stdio, `fdlibm.h` de la libm).
NEWLIB = ROOT / "tools" / "newlib" / "newlib-1_9_0"
NEWLIB_DOSSIERS = ["libc/include", "libc/stdio", "libc/stdlib", "libc/string",
                   "libc/reent", "libc/locale", "libc/time", "libm/common", "libm/math"]


def newlib() -> list[str]:
    """Les `-I` de newlib, copiés une fois dans `/tmp` (même raison que le compilateur)."""
    if not NEWLIB.exists():
        return []
    cible = CACHE / "newlib"
    if not cible.exists():
        CACHE.mkdir(parents=True, exist_ok=True)
        partiel = Path(tempfile.mkdtemp(dir=CACHE, prefix="newlib."))
        for d in NEWLIB_DOSSIERS:
            if (NEWLIB / d).exists():
                shutil.copytree(NEWLIB / d, partiel / "c" / d)
        try:
            (partiel / "c").rename(cible)
        except OSError:
            pass
        shutil.rmtree(partiel, ignore_errors=True)
    return [f"-I{cible / d}" for d in NEWLIB_DOSSIERS if (cible / d).exists()]


def sections_en_text(objet: Path) -> None:
    """Rend `.text` à chaque section `.text.<fonction>` que `-ffunction-sections` a posée.

    `mwccgap` greffe fonction par fonction, donc il lui faut une section par fonction —
    ce que `-ffunction-sections` donne. Mais le script de lien de l'image ne réclame que
    `<unité>.o(.text)` : les sections s'appellent toutes `.text`, comme celles de MWCC.
    """
    bs = chr(92)
    vue = subprocess.run(["mips-ps2-decompals-objdump", "-h", str(objet)],
                         capture_output=True, text=True).stdout
    noms = re.findall(r"^\s*\d+\s+(\.text\.\S+)".replace(chr(92) + chr(92), bs), vue, flags=re.M)
    if not noms:
        return
    args = ["mips-ps2-decompals-objcopy"]
    # Le `.text` vide que GCC pose toujours en tête compterait pour une fonction de plus :
    # on le renomme, ce qui le met hors du script de lien comme de la lecture de mwccgap.
    vide = re.search(r"^\s*\d+\s+\.text\s+0{8}", vue, flags=re.M)
    if vide:
        args += ["--rename-section", ".text=.gcc_text_vide"]
    for n in noms:
        args += ["--rename-section", f"{n}=.text"]
    subprocess.run([*args, str(objet)], check=True)


def stubs_gcc(texte: str) -> str:
    """Les fonctions en `nop` que mwccgap pose à la place d'un `INCLUDE_ASM`, en syntaxe GCC.

    mwccgap les écrit à la manière de MWCC : `asm void nom() { nop … }`. GCC n'a pas cette
    forme ; le même emplacement s'écrit en assembleur de niveau fichier, avec `.ent` et
    `.end` pour que l'assembleur donne au symbole le type et la taille d'une fonction,
    que mwccgap retrouve ensuite pour y greffer le désassemblage.
    """
    bs = chr(92)                      # la barre oblique inverse, pour la chaîne C comme pour le motif
    nl = bs + "n" + bs + "t"          # retour à la ligne puis tabulation, écrits comme une chaîne C les porte

    def un(m: re.Match) -> str:
        nom, corps = m.group(1), m.group(2)
        nops = "".join(nl + "nop" for _ in re.findall(bs + "bnop" + bs + "b", corps))
        lignes = [f".section .text.{nom}", ".align 3", f".globl {nom}", f".ent {nom}", nom + ":",
                  ".set noreorder", ".set nomacro"]
        corps_c = nl.join(lignes) + nops + nl + f".end {nom}" + nl + ".set macro" + nl + ".set reorder"
        return '__asm__("' + corps_c + '");'

    return re.sub("asm void (" + bs + "w+)" + bs + "(" + bs + ")" + bs + "s*" + bs + "{(.*?)" + bs + "}",
                  un, texte, flags=re.S)


def main(argv: list[str]) -> int:
    sortie = None
    source = None
    options: list[str] = []
    i = 0
    while i < len(argv):
        a = argv[i]
        if a == "-o":
            sortie = Path(argv[i + 1]); i += 2; continue
        if a == "-c":
            i += 1; continue
        if not a.startswith("-"):
            source = Path(a); i += 1; continue
        options.append(a); i += 1
    if sortie is None or source is None:
        print("usage : ee_gcc_cc -c <options> -o sortie.o source.c", file=sys.stderr)
        return 2

    racine = compilateur(os.environ.get("EE_GCC", "ee-gcc2.9-991111-01"))
    bib = sorted((racine / "lib" / "gcc-lib" / "ee").glob("*"))[0]
    with tempfile.TemporaryDirectory(dir="/tmp") as tmp:
        tmp = Path(tmp)
        shutil.copytree(ROOT / "include" / "gcc", tmp / "inc")
        copie = tmp / source.name
        copie.write_text(stubs_gcc(source.read_text(encoding="utf-8")), encoding="utf-8")
        objet = tmp / "sortie.o"
        commande = [str(racine / "bin" / "ee-gcc"), f"-B{bib}/", f"-B{racine}/ee/bin/",
                    "-x", "c", "-ffunction-sections", *options, f"-I{tmp / 'inc'}", *newlib(), "-c", "-o", str(objet), str(copie)]
        r = subprocess.run(commande, cwd=tmp, capture_output=True, text=True)
        sys.stderr.write(r.stdout + r.stderr)
        if r.returncode != 0 or not objet.exists():
            return r.returncode or 1
        sections_en_text(objet)
        shutil.copy(objet, sortie)
    return 0


if __name__ == "__main__":
    sys.exit(main(sys.argv[1:]))
