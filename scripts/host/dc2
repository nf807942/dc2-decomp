#!/usr/bin/env bash
# Lance une commande dans le conteneur de construction.
#
#   scripts/host/dc2 make setup
#   scripts/host/dc2 make build
#   scripts/host/dc2 bash          # une session, pour fouiller
#
# L'arbre est monté, jamais copié : ce que la construction écrit reste sur
# l'hôte, et une reconstruction n'a rien à recopier. L'image se construit
# toute seule à la première invocation.
set -euo pipefail

ROOT="$(cd "$(dirname "${BASH_SOURCE[0]}")/../.." && pwd)"
IMAGE=dc2decomp
CONTAINER_WORKDIR=/dc2

# Windows tient les chemins autrement : Git Bash traduit un argument qui
# ressemble à un chemin absolu, ce qui casse les chemins destinés au
# conteneur.
export MSYS_NO_PATHCONV=1

runtime() {
    if command -v docker >/dev/null 2>&1; then
        echo docker
    elif command -v podman >/dev/null 2>&1; then
        echo podman
    else
        echo "ni docker ni podman sur cette machine" >&2
        exit 1
    fi
}

RUNTIME="$(runtime)"

# L'image se reconstruit quand sa recette ou ses dépendances changent. Le
# `docker build` est incrémental, donc l'appeler à chaque fois ne coûte rien
# une fois le cache chaud.
if ! "$RUNTIME" image inspect "$IMAGE" >/dev/null 2>&1; then
    echo "construction de l'image $IMAGE (une seule fois)…" >&2
    "$RUNTIME" build -t "$IMAGE" "$ROOT"
fi

TTY=()
if [ -t 0 ] && [ -t 1 ]; then TTY=(-it); fi

exec "$RUNTIME" run --rm "${TTY[@]}" \
    -v "${ROOT}:${CONTAINER_WORKDIR}" \
    -w "${CONTAINER_WORKDIR}" \
    -e HOME=/tmp \
    "$IMAGE" "${@:-bash}"
